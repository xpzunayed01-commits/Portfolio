rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Contact Messages: Anyone can submit a message, but ONLY authenticated admins can read, update, or delete.
    match /contactMessages/{document} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.name is string && request.resource.data.email is string;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Projects: Public read, authenticated admin write/edit/delete
    match /projects/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Services: Public read, authenticated admin write/edit/delete
    match /services/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Certificates: Public read, authenticated admin write/edit/delete
    match /certificates/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Tools & Technologies: Public read, authenticated admin write
    match /tools/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Site Content (Settings, Profile): Public read, authenticated admin write
    match /siteContent/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Fallback collections for settings & profile
    match /settings/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /profile/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Admin Users Collection
    match /adminUsers/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
